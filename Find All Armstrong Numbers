#include <stdio.h>
#include <math.h>

int isArmstrong(int n) {
    int temp=n, digits=0, sum=0;
    while(temp>0) {
        digits++;
        temp/=10;
    }
    temp=n;
    while(temp>0) {
        int d=temp%10;
        sum += pow(d, digits);
        temp/=10;
    }
    return sum==n;
}

int main() {
    int start, end, found=0;
    scanf("%d %d", &start, &end);

    for(int i=start; i<=end; i++) {
        if(isArmstrong(i)) {
            printf("%d ", i);
            found=1;
        }
    }

    if(!found) printf("No Armstrong numbers found");

    return 0;
}
