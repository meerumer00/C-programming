#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
#include <ctype.h>
int main() {
    char str[1001];
    int i, words = 0;

    // Read the full line including spaces
    scanf("%[^\n]", str);

    // Count words: increment when a space is followed by a non-space character
    for (i = 0; str[i] != '\0'; i++) {
        if ((i == 0 && str[i] != ' ') || (str[i] == ' ' && str[i+1] != ' ' && str[i+1] != '\0')) {
            words++;
        }
    }

    printf("%d\n", words);

    return 0;
}
