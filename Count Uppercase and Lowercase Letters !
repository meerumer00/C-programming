#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
#include <ctype.h>
int main() {
    char str[1001];
    int upper = 0, lower = 0;
    fgets(str, sizeof(str), stdin);
    
   for (int i = 0; str[i] != '\0'; i++) {
        if (isupper(str[i])) {
            upper++;
        } else if (islower(str[i])) {
            lower++;
        }
    }
    printf("%d %d\n", upper, lower);
        return 0;
}  
