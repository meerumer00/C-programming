#include <stdio.h>
#include <string.h>

int main() {
    char s[1001], result[1001];
    int freq[256] = {0};
    fgets(s, sizeof(s), stdin);

    int j = 0;
    for(int i = 0; s[i] != '\0' && s[i] != '\n'; i++) {
        unsigned char c = s[i];
        if(freq[c] == 0) {
            result[j++] = c;
            freq[c] = 1;
        }
    }
    result[j] = '\0';

    printf("%s", result);
    return 0;
}
