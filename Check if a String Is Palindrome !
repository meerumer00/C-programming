#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char s[1001], cleaned[1001];
    int j = 0;
    
    fgets(s, sizeof(s), stdin);

    for(int i = 0; s[i] != '\0'; i++) {
        if(s[i] != ' ')
            cleaned[j++] = tolower(s[i]);
    }
    cleaned[j] = '\0';

    int len = strlen(cleaned), flag = 1;
    for(int i = 0; i < len / 2; i++) {
        if(cleaned[i] != cleaned[len - i - 1]) {
            flag = 0;
            break;
        }
    }

    if(flag) printf("Palindrome");
    else printf("Not Palindrome");

    return 0;
}
