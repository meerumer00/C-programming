#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    long long fact = 1;
    long long sum = 0;
    
    for (int i = 1; i <= n; i++) {
        fact *= i;      // Compute i!
        sum += fact;    // Add to sum
    }
    
    printf("%lld\n", sum);
    return 0;
}
