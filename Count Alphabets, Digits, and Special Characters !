#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
#include <ctype.h>

int main() {
    char str[1001];  // 1 extra for null terminator
    int alphabets = 0, digits = 0, special = 0;

    scanf("%[^\n]s", str);  // Read entire line including spaces

    for (int i = 0; str[i] != '\0'; i++) {
        if (isalpha(str[i]))
            alphabets++;
        else if (isdigit(str[i]))
            digits++;
        else
            special++; // counts spaces and punctuation as special
    }

    printf("%d %d %d\n", alphabets, digits, special);

    return 0;
}
