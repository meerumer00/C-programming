#include <stdio.h>

int isPrime(int n) {
    if(n < 2) return 0;
    for(int i = 2; i * i <= n; i++)
        if(n % i == 0) return 0;
    return 1;
}

int main() {
    int start, end, found = 0;
    scanf("%d %d", &start, &end);

    for(int i = start; i <= end; i++) {
        if(isPrime(i)) {
            printf("%d ", i);
            found = 1;
        }
    }

    if(!found) printf("No prime numbers found");

    return 0;
}
