#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    int freq[256] = {0};
    fgets(s, sizeof(s), stdin);

    int max = 0;
    char maxChar;

    for(int i = 0; s[i] != '\0'; i++) {
        unsigned char c = s[i];
        freq[c]++;
    }

    for(int i = 0; s[i] != '\0'; i++) {
        unsigned char c = s[i];
        if(freq[c] > max) {
            max = freq[c];
            maxChar = c;
        }
    }

    printf("%c occurs %d times", maxChar, max);

    return 0;
}
